    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[0]'
      value: "Bonjour \xE9tranger de ce monde?"
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[1]'
      value: "Tu as pu \xE9valuer la Cam\xE9ra de ce monde comme acquis !"
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[2]'
      value: "Tu dois maintenant t'occuper du 3 \xE8me et dernier C de ce monde..."
