--- !u!1001 &1907619320
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: _dialogueCamera
      value: 
      objectReference: {fileID: 652629279}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: _lines.Array.size
      value: 8
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[0]'
      value: 'Bonjour, voyageur d''un autre monde ? '
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[1]'
      value: "peu importe, j'ai besoin de toi pour \xE9valuer les C de ce monde."
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[2]'
      value: "Premi\xE8rement, le Controller ! "
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[3]'
      value: "Cours, saute, roule partout jusqu'\xE0 ce que tu te sens pr\xEAt \xE0
        te d\xE9fouler dans le donjon."
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[4]'
      value: "Une fois le donjon nettoy\xE9, revient me voir."
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[5]'
      value: Parfait ! Tu as maintenant pu voir que le Controller de ce monde est
        acquis.
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[6]'
      value: "Maintenant, voyons voir comment tu arrives \xE0 te rep\xE9rer dans
        ce monde avec la Camera."
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[7]'
      value: Trouve mon ami Pedro
      objectReference: {fileID: 0}
    - target: {fileID: 501879332222916685, guid: 7c95f4afafd958940b06a722238beede, type: 3}
      propertyPath: '_lines.Array.data[8]'
      value: Trouve mon ami Pedro
      objectReference: {fileID: 0}
